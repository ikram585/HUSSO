<Window x:Class="TELSEFA.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TELSEFA - Giris" Height="620" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PrimarySoftBrush}">
            <Grid Margin="48,54">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="TELSEFA" FontSize="52" FontWeight="ExtraBold"
                       Foreground="{StaticResource PrimaryBrush}" Background="Transparent"/>

                <TextBlock Grid.Row="1" Text="Telefon Magazasi &amp; Servis Yonetim Sistemi"
                           FontSize="14" Foreground="{StaticResource TextDimBrush}" Background="Transparent"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>

                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <StackPanel.Resources>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="0,0,0,10"/>
                        </Style>
                    </StackPanel.Resources>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="22" Height="22" Fill="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Stok &amp; IMEI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Anlik stok, barkod okutma, seri/IMEI takibi" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="22" Height="22" Fill="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Alim / Satis" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Tek ekrandan fis, iade ve stok hareketi" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="22" Height="22" Fill="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Cari Hesap" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Musteri borcu, tahsilat, ekstre yazdirma" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="22" Height="22" Fill="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="A4 Fatura" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Tek tikla yazdirilabilir fatura ve fis" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="22" Height="22" Fill="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Raporlar" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Gunluk satis, kar-zarar, en cok satilanlar" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="22" Height="22" Fill="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Yedekleme" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text=".db dosyasi otomatik yedeklenir" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="Surum 1.0.0  -  Tum veriler bilgisayarinizda kalir (offline)"
                           FontSize="10" Foreground="{StaticResource TextDimBrush}" Background="Transparent"/>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource BgBrush}">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="18" MaxWidth="400" Padding="30,28">
                    <StackPanel>
                        <Label Content="GIRIS YAP" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" Background="Transparent"/>
                        <Label Content="Devam etmek icin bilgilerinizi giriniz"
                               FontSize="12" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center" Background="Transparent" Margin="0,4,0,0"/>

                        <TextBox x:Name="UsernameBox" Margin="0,16,0,0" Height="42"
                                 VerticalContentAlignment="Center"
                                 Tag="Kullanici adi"/>
                        <PasswordBox x:Name="PasswordBox" Margin="0,10,0,0" Height="42"
                                     VerticalContentAlignment="Center"
                                     Tag="Sifre"/>

                        <CheckBox x:Name="RememberCheck" Content="Beni hatirla"
                                  Margin="0,10,0,0" Background="Transparent"/>

                        <TextBlock x:Name="MessageText" FontSize="11" TextWrapping="Wrap"
                                   MinHeight="18" Margin="0,6,0,0" Background="Transparent"/>

                        <Button x:Name="LoginButton" Content="GIRIS YAP" Height="44"
                                Margin="0,10,0,0" Style="{StaticResource PrimaryButtonStyle}"
                                Click="LoginButton_Click"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Temizle" Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Left" Click="ClearButton_Click"/>
                            <Button Grid.Column="1" Content="Cikis" Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Right" Click="ExitButton_Click"/>
                        </Grid>

                        <Button x:Name="ThemeButton" Content="Koyu Tema" Style="{StaticResource GhostButtonStyle}"
                                Margin="0,4,0,0" Click="ThemeButton_Click"/>
                        <Button x:Name="ForgotButton" Content="Sifremi Unuttum" Style="{StaticResource GhostButtonStyle}"
                                Margin="0,4,0,0" Click="ForgotButton_Click"
                                Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
